---
// Starlight's head, plus the site's fonts loaded ahead of the page. Without this the text
// would first be drawn in a fallback font, and change on every page.
import Default from "@astrojs/starlight/components/Head.astro"
import plex from "../assets/fonts/ibm-plex-sans-latin-wght-normal.woff2?url"
import retro from "../assets/fonts/retro.ttf?url"
---

<Default><slot /></Default>
<link rel="preload" href={plex} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={retro} as="font" type="font/ttf" crossorigin />
