---
// The score in the top bar, in the place of Starlight's social icons: the coins picked up on
// this page, and the sessions read to the end. Footer.astro does the counting.
import coin from "../assets/strip/coin.png"
import diamond from "../assets/strip/diamond.png"

// Coins are collected on the session pages only, one for each section. The number of sections
// is known here, so the count is in the page from the start and never pops in.
const { entry, headings } = Astro.locals.starlightRoute
const sections = entry.id.startsWith("sessions/") ? headings.filter((h) => h.depth === 2).length : 0
---

<div class="gar-hud" aria-hidden="true">
  {
    sections > 0 && (
      <span class="score coins">
        <img class="hud-coin" src={coin.src} alt="" width="18" height="18" />
        <b>0/{sections}</b>
      </span>
    )
  }
  <span class="score sessions"><img class="hud-gem" src={diamond.src} alt="" width="18" height="18" /><b>0/12</b></span>
</div>

<!-- Runs before the bar is first drawn, so the count never shows as 0 and then changes. -->
<script is:inline>
  try {
    const done = JSON.parse(localStorage.getItem("gar-done") ?? "[]")
    for (const b of document.querySelectorAll(".gar-hud .sessions b")) b.textContent = `${done.length}/12`
  } catch {}
</script>

<script>
  // The score is on the page twice: in the bar, and in the menu of a narrow window.
  for (const hud of document.querySelectorAll<HTMLElement>(".gar-hud")) {
    const coins = hud.querySelector<HTMLElement>(".coins")
    const sessions = hud.querySelector<HTMLElement>(".sessions b")!

    const showSessions = () => {
      let done: string[] = []
      try {
        done = JSON.parse(localStorage.getItem("gar-done") ?? "[]")
      } catch {
        // No storage: the count stays at zero.
      }
      sessions.textContent = `${done.length}/12`
    }

    document.addEventListener("gar-score", (event) => {
      if (!coins) return
      const { coins: got, of } = (event as CustomEvent<{ coins: number; of: number }>).detail
      const label = coins.querySelector("b")!
      if (label.textContent !== `${got}/${of}`) {
        label.textContent = `${got}/${of}`
        coins.classList.remove("bump")
        void coins.offsetWidth
        if (got > 0) coins.classList.add("bump")
      }
    })
    document.addEventListener("gar-done", showSessions)
    showSessions()
  }
</script>

<style is:global>
  .gar-hud {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: "GAR Retro", var(--__sl-font);
    font-size: 0.7rem;
    /* White in the bar, and the text colour in the menu of a narrow window. */
    color: var(--sl-color-white);
    white-space: nowrap;
  }
  /* The icons stand on the line the digits stand on, as a letter would, instead of being
     centred on them. Each image has a few transparent pixels under its drawing, and the
     digits end a little above the font's baseline: the offsets make up the difference. */
  .gar-hud .score {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .gar-hud img {
    position: relative;
  }
  .gar-hud img.hud-coin {
    top: 2px;
  }
  .gar-hud img.hud-gem {
    top: 1px;
  }
  .gar-hud .score[hidden] {
    display: none;
  }
  .gar-hud img {
    width: 18px;
    height: 18px;
    image-rendering: pixelated;
  }
  .gar-hud b {
    font-weight: 400;
    min-width: 3.2em;
  }
  .gar-hud .bump img {
    animation: gar-bump 260ms ease-out;
  }
  @keyframes gar-bump {
    40% {
      transform: translateY(-5px) scale(1.25);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gar-hud .bump img {
      animation: none;
    }
  }
</style>
