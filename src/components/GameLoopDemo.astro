---
/**
 * Fixed-timestep demo: the simulation ticks at an adjustable rate while the
 * canvas renders at the display's refresh rate. The top lane draws the latest
 * tick state; the bottom lane interpolates between the last two ticks.
 */
---

<game-loop-demo>
	<canvas></canvas>
	<div class="controls">
		<label>
			Simulation tick rate
			<input type="range" min="2" max="60" value="8" />
			<output>8 Hz</output>
		</label>
		<button type="button">Pause</button>
	</div>
</game-loop-demo>

<style>
	game-loop-demo {
		display: block;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		padding: 1rem;
	}
	canvas {
		display: block;
		width: 100%;
		height: 9rem;
	}
	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
	}
	label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	output {
		font-variant-numeric: tabular-nums;
		min-width: 3.5em;
	}
	button {
		font: inherit;
		color: var(--sl-color-text);
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.25rem;
		padding: 0.25rem 0.75rem;
		cursor: pointer;
	}
</style>

<script>
	const SPEED = 0.6; // lane widths per second
	const RADIUS = 9;

	class GameLoopDemo extends HTMLElement {
		#frame = 0;

		connectedCallback() {
			const canvas = this.querySelector('canvas')!;
			const ctx = canvas.getContext('2d')!;
			const slider = this.querySelector('input')!;
			const output = this.querySelector('output')!;
			const button = this.querySelector('button')!;

			let dt = 1 / Number(slider.value);
			let paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
			let x = 0;
			let prevX = 0;
			let velocity = SPEED;
			let accumulator = 0;
			let last = performance.now();

			const syncButton = () => (button.textContent = paused ? 'Play' : 'Pause');
			syncButton();
			slider.addEventListener('input', () => {
				dt = 1 / Number(slider.value);
				output.textContent = `${slider.value} Hz`;
			});
			button.addEventListener('click', () => {
				paused = !paused;
				syncButton();
			});

			const update = () => {
				prevX = x;
				x += velocity * dt;
				if (x > 1) [x, velocity] = [2 - x, -velocity];
				if (x < 0) [x, velocity] = [-x, -velocity];
			};

			const draw = (alpha: number) => {
				const dpr = devicePixelRatio;
				const { clientWidth: w, clientHeight: h } = canvas;
				if (canvas.width !== w * dpr || canvas.height !== h * dpr) {
					canvas.width = w * dpr;
					canvas.height = h * dpr;
				}
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				ctx.clearRect(0, 0, w, h);

				const style = getComputedStyle(this);
				const text = style.getPropertyValue('--sl-color-gray-2');
				const line = style.getPropertyValue('--sl-color-hairline');
				const accent = style.getPropertyValue('--sl-color-accent');
				const lanes: [string, number][] = [
					['Latest tick state', x],
					['Interpolated', prevX + (x - prevX) * alpha],
				];

				ctx.font = '12px system-ui, sans-serif';
				lanes.forEach(([label, pos], i) => {
					const top = (h / 2) * i;
					const y = top + h / 4 + 8;
					const px = RADIUS + pos * (w - RADIUS * 2);
					ctx.fillStyle = text;
					ctx.fillText(label, 0, top + 14);
					ctx.strokeStyle = line;
					ctx.beginPath();
					ctx.moveTo(0, y);
					ctx.lineTo(w, y);
					ctx.stroke();
					ctx.fillStyle = accent;
					ctx.beginPath();
					ctx.arc(px, y, RADIUS, 0, Math.PI * 2);
					ctx.fill();
				});
			};

			const loop = (now: number) => {
				const frameTime = Math.min((now - last) / 1000, 0.25);
				last = now;
				if (!paused) {
					accumulator += frameTime;
					while (accumulator >= dt) {
						update();
						accumulator -= dt;
					}
				}
				draw(accumulator / dt);
				this.#frame = requestAnimationFrame(loop);
			};
			this.#frame = requestAnimationFrame(loop);
		}

		disconnectedCallback() {
			cancelAnimationFrame(this.#frame);
		}
	}

	customElements.define('game-loop-demo', GameLoopDemo);
</script>
